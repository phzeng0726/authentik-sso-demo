# Copy this file to .env and fill in the values from authentik
# (Applications > Providers > site-b > Client ID / Client Secret).
# .env is gitignored; never commit real secrets.

# Optional: defaults shown
PORT=8082
SITE_NAME="Site B"
OIDC_ISSUER=http://localhost:9000/application/o/site-b/
OIDC_REDIRECT_URL=http://localhost:3002/api/auth/callback

# Required
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
