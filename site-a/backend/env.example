# Copy this file to .env and fill in the values from authentik
# (Applications > Providers > site-a > Client ID / Client Secret).
# .env is gitignored; never commit real secrets.

# Optional: defaults shown
PORT=8081
SITE_NAME="Site A"
OIDC_ISSUER=http://localhost:9000/application/o/site-a/
OIDC_REDIRECT_URL=http://localhost:3001/api/auth/callback

# Required
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
